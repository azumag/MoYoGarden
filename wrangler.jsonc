{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moyo-garden",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGIONS",
        "class_name": "RegionDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegionDurableObject"]
    }
  ],
  "vars": {
    "DEFAULT_REGION_ID": "garden-1",
    "REGION_IDS": "garden-1",
    "WORLD_SEED": "424242",
    "TICK_MS": "10000",
    "OPEN_COMMANDS": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist-ts",
    "rootDir": ".",
    "types": [],
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/server.ts",
    "src/api-client.ts",
    "src/demo-bot.ts",
    "src/llm-bot.ts",
    "src/mcp.ts"
  ]
}
